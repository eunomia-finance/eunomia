{
  "name": "eunomia-mcp",
  "version": "0.3.1",
  "description": "MCP server + TypeScript SDK that lets any AI agent spend from a Eunomia treasury on Stellar — find and buy paid services from a bounded float, pay inside an owner-set on-chain budget, ask for task budgets, refused by the contract when out of policy.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "eunomia-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "npm-shrinkwrap.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eunomia-finance/eunomia.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://eunomia.finance",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "stellar",
    "soroban",
    "x402",
    "ai-agent",
    "treasury",
    "spending-policy"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test src/*.test.ts",
    "smoke": "tsx scripts/client-smoke.ts",
    "sync:bindings": "node scripts/same.mjs --write ../treasury-client/src/index.ts src/bindings/treasury.ts",
    "check:bindings": "node scripts/same.mjs ../treasury-client/src/index.ts src/bindings/treasury.ts",
    "check:codec": "node scripts/same.mjs src/exceptionCodec.ts ../../web/src/lib/exceptionCodec.ts && node scripts/same.mjs src/budgetRequestCodec.ts ../../web/src/lib/budgetRequestCodec.ts",
    "prepublishOnly": "npm run check:bindings && npm run check:codec && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@stellar/stellar-sdk": "^16.3.1",
    "@x402/core": "~2.28.0",
    "@x402/fetch": "~2.28.0",
    "@x402/stellar": "~2.28.0",
    "buffer": "6.0.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "axios": "^1.20.0"
  }
}
