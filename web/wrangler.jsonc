{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The app on Cloudflare (SOW 2: Vercel → Cloudflare). Static assets plus worker/index.ts
  // for /api/relay. Build first (npm run build, with the EUNOMIA_* settings), then
  // wrangler deploy.
  "name": "eunomia-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // stellar-sdk decodes XDR with Buffer
  "compatibility_flags": ["nodejs_compat"],
  // eunomia.finance is the passkey rp.id (src/config.ts RP_ID); www is redirected to it by a
  // zone rule, not served here.
  "routes": [{ "pattern": "eunomia.finance", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The relay pays a fee for every call it admits. Per client IP and per signing wallet, each
  // per Cloudflare location; neither bounds the bill on its own, the daily budget below does.
  "ratelimits": [
    { "name": "RELAY_LIMITER", "namespace_id": "4401", "simple": { "limit": 20, "period": 60 } },
    { "name": "RELAY_WALLET_LIMITER", "namespace_id": "4402", "simple": { "limit": 10, "period": 60 } },
    // /api/rpc, per client IP. A page load reads a treasury in a dozen calls and the ledger
    // polls, so this is generous; it stops a script from spending the provider plan.
    { "name": "RPC_LIMITER", "namespace_id": "4403", "simple": { "limit": 300, "period": 60 } }
  ],
  // The day's fee total, shared by every instance (worker/relayBudget.ts).
  "durable_objects": {
    "bindings": [{ "name": "RELAY_BUDGET", "class_name": "RelayBudget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayBudget"] }],
  // Mainnet only. Without any of these, or without its secrets, the relay answers 503 rather
  // than guess (fails closed).
  // Optional: RELAY_MAX_FEE_XLM (default 1), RELAY_MIN_BALANCE_XLM (default 5) and
  // RELAY_SAFETY_BUDGET_XLM (default 5): what an owner's exit calls — revoke, pause, withdraw —
  // may still spend in a day once the daily budget below is gone.
  // Secrets (wrangler secret put …): RELAY_SECRET, the fee account; RELAY_RPC_URL, the RPC
  // provider's URL — it carries the account key, so it is never a var. The relay submits
  // through it and /api/rpc forwards the browser's calls to it.
  "vars": {
    "RELAY_NETWORK": "pubnet",
    // the treasury factory and the registry (src/networks.ts, DEPLOYMENT.md)
    "RELAY_FACTORY_ID": "CBO5F4MRST2BH4W3SSXSQXKFBTK5Y5AWNTVDH47KO65MXJTBTYSFUPEB",
    "RELAY_ALLOWED_CONTRACTS": "CCQQBCR55OZKAGHNIWOOX265XTYITLOAXITLTPJTZNYEOJYT2QDZTNXB",
    // the passkey smart wallet (config.ts WALLET_WASM_HASH): creating one is a deploy the
    // relay pays for. The treasury wasm is admitted in code (relayGuard.allowedWasmHashes).
    "RELAY_ALLOWED_WASM": "fdefad64b96837147e1c333e51f537b696eab925e9f147e63d597c04e3c903f0",
    // decided 2026-10-24; raise it as passkey users arrive
    "RELAY_DAILY_BUDGET_XLM": "20"
  },
  "observability": { "enabled": true }
}
